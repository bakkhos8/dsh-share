<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!--
      收件箱必须放在「扩展沙盒之外的普通用户目录」，否则 DSH 主进程读不到：
      macOS 把 ~/Library/Containers 视为受保护的 app 数据，未授权（Full Disk Access）的
      DSH 进程会被 System Policy 直接 deny file-read-data。
      home-relative 的 temporary exception 允许沙盒扩展读写：
        ~/Library/Application Support/DSHShare/
      DSH 是非沙盒的 Node 进程，读这个路径不需要任何授权。
    -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Application Support/DSHShare/</string>
    </array>
</dict>
</plist>
